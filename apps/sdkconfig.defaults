# Camera (BF3901 SPI) - from simple_video_server demo
CONFIG_ESP32_S3_BOX_3_BOARD=y
CONFIG_EXAMPLE_SELECT_CUSTOMIZED_DEV_BOARD=y
CONFIG_EXAMPLE_ENABLE_SPI_CAM_0_SENSOR=y
CONFIG_EXAMPLE_SPI_CAM_0_INTERFACE_SPI=y
CONFIG_EXAMPLE_SPI_CAM_0_SCCB_I2C_FREQ=100000
CONFIG_EXAMPLE_SPI_CAM_0_SPI_PORT=2
CONFIG_EXAMPLE_SPI_CAM_0_XCLK_USE_LEDC=y
CONFIG_EXAMPLE_SPI_CAM_0_XCLK_FREQ=24000000
CONFIG_EXAMPLE_SPI_CAM_0_XCLK_TIMER=3
CONFIG_EXAMPLE_SPI_CAM_0_XCLK_TIMER_CHANNEL=7
CONFIG_EXAMPLE_SPI_CAM_0_SENSOR_RESET_PIN=-1
CONFIG_EXAMPLE_SPI_CAM_0_SENSOR_PWDN_PIN=-1
CONFIG_EXAMPLE_SPI_CAM_0_XCLK_PIN=-1
CONFIG_EXAMPLE_SPI_CAM_0_CS_PIN=13
CONFIG_EXAMPLE_SPI_CAM_0_SCLK_PIN=2
CONFIG_EXAMPLE_SPI_CAM_0_DATA0_IO_PIN=12
CONFIG_EXAMPLE_SCCB_I2C_INIT_BY_APP=y
CONFIG_EXAMPLE_SCCB_I2C_PORT_INIT_BY_APP=0
CONFIG_EXAMPLE_SCCB_I2C_SCL_PIN_INIT_BY_APP=10
CONFIG_EXAMPLE_SCCB_I2C_SDA_PIN_INIT_BY_APP=9
CONFIG_EXAMPLE_CAMERA_VIDEO_BUFFER_NUMBER=2
CONFIG_EXAMPLE_SELECT_JPEG_ESP_NEW_JPEG=y
CONFIG_CAMERA_BF3901=y
CONFIG_CAMERA_BF3901_AUTO_DETECT_SPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_BF3901_SPI_YUV422_240X320_15FPS=y
CONFIG_CAMERA_BF3901_SPI_DEFAULT_FMT_YUV422_240X320_15FPS=y
CONFIG_CAMERA_BF3901_SPI_IF_FORMAT_INDEX_DEFAULT=1
CONFIG_CAMERA_SENSOR_XCLK_INPUT_24M=y
CONFIG_CAMERA_XCLK_USE_LEDC=y
CONFIG_ESP_VIDEO_ENABLE_DATA_PREPROCESSING=y
CONFIG_ESP_VIDEO_CHECK_PARAMETERS=y
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=y

# Reduce BLE controller RAM usage (LVGL + WiFi + BLE coexist)
CONFIG_BT_CTRL_BLE_MAX_ACT=4

# Keep enough internal heap for WiFi static RX buffers after PSRAM-heavy init
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
