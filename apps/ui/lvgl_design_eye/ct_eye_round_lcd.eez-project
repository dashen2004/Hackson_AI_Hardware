        "objID": "e12f7968-997b-4618-f18a-987200e9ca43",
        "filePath": "font\\PingFang Regular.otf",
        "size": 16
      },
      "embeddedFontFile": "",
      "bpp": 4,
      "threshold": 128,
      "height": 18,
      "ascent": 15,
      "descent": 3,
      "glyphs": [],
      "lvglRanges": "32-127",
      "lvglSymbols": "休息中身 直 卫 士 看 到 你 歪 我 请 帮 调 整 位失败累计格足再就能啦道了长下光线打卡成功亮度不太合适哦刚刚好光线检测中...摄像头已开启打卡坐端正、离书远一点标准姿坚持20分钟暂停继续跳过光线过亮暗晃眼睛记得拉上窗帘哟的快打开小台灯吧～ ℃晴多云阴阵雨雷伴有冰雹夹雪小中大暴雾冻沙尘浮霾未知闹钟星期一二三四五六日年月番茄时钟宁波市闹  语文 数学 英语 体育 品德 午休  未打卡 已打卡 晨间唤醒 户外活动 睡前准备 眼保健操 居家学习 完成 美术 剩余时间 专注中 番茄时钟 系统设置声音设备配网静音模式将清除WiFi配置并进入是否继续确认取消，,",
      "lvglBinFile": "",
      "lvglGlyphs": {
        "encodings": [
          {
            "from": 32,
            "to": 127
          }
        ],
        "symbols": ""
      }
    },
