
#
# qumios
#

#
# qumi kernel
#
CONFIG_QM_LOG=y
CONFIG_LOG_SIMPLE=y
# CONFIG_LOG_DETAILS is not set
CONFIG_QM_MTRACE_SUPPORT=y
# end of qumi kernel
# end of qumios

#
# components
#

#
# qm at
#
# CONFIG_QM_AT is not set
CONFIG_QM_AT_SERVER_TASK_SIZE=2048
CONFIG_QM_AT_SERVER_TASK_PRIO=20
CONFIG_QM_AT_SERVER_MAX_NUM=3
CONFIG_QM_AT_CLIENT_TASK_SIZE=2048
CONFIG_QM_AT_CLIENT_TASK_PRIO=20
CONFIG_QM_AT_CMD_TABLE_MAX_NUM=10
CONFIG_QM_AT_URC_TABLE_MAX_NUM=3
# end of qm at

#
# xjiang cloud
#
CONFIG_OTA_SUPPORT=y
CONFIG_DYN_REG_SUPPORT=y
# end of xjiang cloud

#
# qm ble
#
# CONFIG_QM_BLE is not set
# end of qm ble

#
# network
#
# CONFIG_QM_NETWORK_TLS_SUPPORT is not set
# end of network

#
# NTP
#
CONFIG_QM_TIME_TASK_PRIO=21
CONFIG_QM_TIME_TASK_SIZE=4096
CONFIG_QM_TIME_SYNC_TIMEOUT=21600
# end of NTP

#
# http
#
# CONFIG_QM_HTTPS_SUPPORT is not set
CONFIG_HTTP_DEBUG_PRINT=y
CONFIG_HTTPCLIENT_CHUNK_SIZE=1024
CONFIG_HTTPCLIENT_SEND_BUF_SIZE=512
# end of http
# end of components

#
# utility
#

#
# cli
#
CONFIG_QM_CLI_SUPPORT=y
# end of cli

#
# TLV/DTTV
#
CONFIG_QM_TLV_SUPPORT=y
CONFIG_QM_TLV_TAG_SIZE=1
CONFIG_QM_TLV_LENGTH_SIZE=1
CONFIG_QM_TLV_BYTES_SIZE=4
CONFIG_QM_TLV_INT16_SUPPORT=y
CONFIG_QM_TLV_INT32_SUPPORT=y
CONFIG_QM_TLV_INT64_SUPPORT=y
CONFIG_QM_TLV_BYTES_SUPPORT=y
CONFIG_QM_DTTV_SUPPORT=y
CONFIG_QM_DTTV_TAG_SIZE=1
CONFIG_QM_DTTV_LENGTH_SIZE=1
CONFIG_QM_DTTV_BYTES_SIZE=4
CONFIG_QM_DTTV_INT16_SUPPORT=y
CONFIG_QM_DTTV_INT32_SUPPORT=y
# CONFIG_QM_DTTV_INT64_SUPPORT is not set
CONFIG_QM_DTTV_BYTES_SUPPORT=y
# end of TLV/DTTV
# end of utility
